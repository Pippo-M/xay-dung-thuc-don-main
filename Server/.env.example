# Sao chép file này thành Server/.env rồi điền giá trị thật.
# Server/.env đã nằm trong .gitignore — KHÔNG commit.
# Trên Render: nhập các biến này ở tab Environment, không cần file .env.

# Bắt buộc — server dừng ngay nếu thiếu
DB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=
DB_NAME=test
JWT_SECRET=

# Chatbot AI (thiếu thì chat báo lỗi, phần còn lại vẫn chạy)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Đăng nhập Google: dán NGUYÊN nội dung file serviceAccount.json trên MỘT dòng
FIREBASE_SERVICE_ACCOUNT=

# Tùy chọn
ADMIN_EMAIL=
EMAIL_USER=
EMAIL_PASS=
